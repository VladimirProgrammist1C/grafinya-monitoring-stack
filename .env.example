# =====================================================================
# Шаблон переменных окружения стека Графини
# Разложите секции по файлам:
#   секция 1 -> .env_backend
#   секция 2 -> .env_frontend
#   секция 3 -> .env_mongo
#   секция 4 -> .env (корень, для интерполяции docker-compose)
# =====================================================================

# ------------------- .env_backend -------------------
MONGO_URI=mongodb://grafinya_admin:CHANGE_ME@grafinya-mongo:27017/grafinya?authSource=admin
PORT=5000
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
EXPIRES_TOKEN=24h
EXPIRES_REFRESH_TOKEN=7d
ALLOWED_ORIGIN=http://localhost:3004
INACTIVE_USER_DEACTIVATION_CHECK_INTERVAL_MINUTES=60
ADMIN_MAX_CONCURRENT_SESSIONS=2
SECURITY_LOG_FILE_PATH=/app-data/security/security.log
INTERNAL_TOKEN=CHANGE_ME
FEATURE_DASHBOARD_CACHE=true
FEATURE_DASHBOARD_FORECAST=true
INTERNAL_WARMUP_URL=http://grafinya-backend:5000/internal/cache/warmup-dashboard
CACHE_WORKER_INTERVAL_SEC=30
CACHE_HARD_MAX_STALE_SEC=900
TARANTOOL_CACHE_HOST=grafinya-tarantool
TARANTOOL_CACHE_PORT=3301

# ------------------- .env_frontend -------------------
VITE_API_BASE_URL=/api/v1
VITE_FEATURE_DASHBOARD_CACHE=true
VITE_FEATURE_DASHBOARD_FORECAST=true
NGINX_HOST=0.0.0.0
NGINX_PORT=80

# ------------------- .env_mongo -------------------
MONGO_INITDB_ROOT_USERNAME=grafinya_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=grafinya

# ------------------- .env (корень) -------------------
VOCECHAT_API_KEY=CHANGE_ME
VOCECHAT_CHANNEL_ID=4
VOCECHAT_HOST=vocechat-notifications